---
import '@fontsource-variable/outfit';
import '../styles/global.css';

interface Props { title: string; description: string; image?: string }
const { title, description, image } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SeasonSerif-TRIAL-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/otf" href="/fonts/ABCOracle-Book-Trial.otf" crossorigin />
    {image && <link rel="preload" as="image" href={image} fetchpriority="high" />}
    <!-- Motion only applies once JS is confirmed, so content is never hidden without it. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <script>import '../scripts/main.ts';</script>
  </body>
</html>
