---
const { data } = Astro.props;
---
<section class="deal section">
  <div data-reveal data-inview>
    <h2 class="deal__title serif">{data.heading}</h2>
    <p class="deal__body">{data.body}</p>
    <p class="deal__pill" data-inview>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {data.reassurance}
    </p>
  </div>
  <div class="deal__card" data-inview data-threshold="0.3">
    <h3 class="deal__stay serif">{data.stayTitle}</h3>
    <p class="deal__eyebrow">{data.eyebrow}</p>
    <dl style="margin:0">
      {data.benefits.map((b: any, i: number) => <div class="deal__row" style={`--i:${i}`}><dt>{b.label}</dt><dd>{b.value}</dd></div>)}
    </dl>
    <p class="deal__total" style={`--i:${data.benefits.length}`}><span>{data.priceLabel}</span><strong>{data.price}</strong></p>
  </div>
</section>
