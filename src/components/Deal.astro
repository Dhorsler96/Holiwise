---
/* Premium: an invite-only, agent-led membership. The card lists what every
   member has and gives invited guests a way in with their code. */
const { data } = Astro.props;
---
<section class="deal section" id="premium">
  <div data-reveal data-inview>
    <h2 class="deal__title serif">{data.heading}</h2>
    <p class="deal__body">{data.body}</p>
    <p class="deal__pill" data-inview>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {data.reassurance}
    </p>
    <div class="deal__cta">
      <a class="btn btn--dark" href={data.ctaHref}>{data.ctaLabel}</a>
      {data.ctaNote && <span class="deal__note">{data.ctaNote}</span>}
    </div>
  </div>
  <div class="deal__card" data-inview data-threshold="0.3">
    <div class="deal__top">
      <h3 class="deal__stay serif">{data.cardTitle}</h3>
      {data.badge && <em class="deal__badge">{data.badge}</em>}
    </div>
    <p class="deal__eyebrow">{data.eyebrow}</p>
    <dl style="margin:0">
      {data.benefits.map((b: any, i: number) => <div class="deal__row" style={`--i:${i}`}><dt>{b.label}</dt><dd>{b.value}</dd></div>)}
    </dl>
    {data.inviteLinkHref && (
      <p class="deal__invite" style={`--i:${data.benefits.length}`}>
        <span>{data.inviteLabel}</span>
        <a class="arrow-link" href={data.inviteLinkHref}><span class="arrow-link__text">{data.inviteLinkLabel}</span> <span class="arrow-link__arrow" aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
</section>
