---
const { hero, destinations } = Astro.props;
const words = hero.headline.split(' ');
// Search is a place and real dates (11 Nov call): the places we can show options for, then popular cities.
const places = [...destinations.map((d: any) => d.title), 'Paris', 'Rome', 'Lisbon', 'Dubai'];
const suggestions: string[] = hero.tellSuggestions ?? ['Flights and a hotel', 'A hotel in one city', 'A special occasion', 'Several stops, one trip', 'Not sure yet'];
---
<section class="hero" id="top" data-theme="dark">
  <div class="hero__media">
    <img src={hero.poster.src} alt={hero.poster.alt} fetchpriority="high" decoding="async" />
    {hero.videoUrl && <video src={hero.videoUrl} muted loop playsinline preload="metadata" data-hero-video aria-hidden="true"></video>}
  </div>

  <div class="hero__copy">
    <h1 class="hero__title serif" aria-label={hero.headline}>
      <span class="mask" aria-hidden="true">
        {words.map((w: string, i: number) => <><span style={`--i:${i}`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
      </span>
    </h1>
    <p class="hero__intro">{hero.intro}</p>
  </div>

  <div class="hero__search">
    <div class="tabs" role="tablist" aria-label="What are you looking for" data-tabs>
      <button class="tabs__tab" role="tab" aria-selected="true" data-tab="stays" type="button">Stays</button>
      <button class="tabs__tab" role="tab" aria-selected="false" data-tab="flights" type="button">Flights</button>
      <div class="tabs__active" aria-hidden="true"><span>Stays</span><span>Flights</span></div>
    </div>

    <form class="search" data-search novalidate>
      <div class="field" data-field="where">
        <button class="field__btn" type="button" aria-haspopup="listbox" aria-expanded="false">
          <span class="field__name" data-where-label>Where</span>
          <span class="field__value" data-value>Search a city or hotel</span>
        </button>
        <div class="pop" role="listbox" aria-label="Where">
          <p class="pop__title">Where are you going?</p>
          <input class="pop__search" type="text" autocomplete="off" placeholder="Search a city or hotel" aria-label="Search a city or hotel" data-where-search />
          <button class="pop__opt pop__opt--custom" type="button" role="option" aria-selected="false" data-opt="" data-opt-custom hidden></button>
          {places.map((p) => <button class="pop__opt" type="button" role="option" aria-selected="false" data-opt={p}>{p}</button>)}
          <p class="pop__empty" data-where-empty hidden>Nothing in the list yet, but your agent can find it.</p>
        </div>
      </div>

      <div class="field" data-field="when">
        <button class="field__btn" type="button" aria-haspopup="true" aria-expanded="false">
          <span class="field__name">When</span>
          <span class="field__value" data-value>Add dates</span>
        </button>
        <div class="pop pop--dates" role="dialog" aria-label="Choose your dates">
          <div class="dates__mode" role="tablist" aria-label="Exact or flexible dates">
            <span class="dates__pill" aria-hidden="true"></span>
            <button type="button" role="tab" aria-selected="true" data-date-mode="dates">Dates</button>
            <button type="button" role="tab" aria-selected="false" data-date-mode="flexible">Flexible</button>
          </div>
          <div class="dates__panel" data-date-panel="dates">
          <div class="cal" data-cal>
            <button class="cal__arrow cal__arrow--prev" type="button" aria-label="Previous month" data-cal-prev><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button class="cal__arrow cal__arrow--next" type="button" aria-label="Next month" data-cal-next><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <div class="cal__months" data-cal-months></div>
          </div>
          <div class="cal__flex" role="group" aria-label="How flexible are your dates?">
            {[['Exact dates', '0'], ['± 1 day', '1'], ['± 2 days', '2'], ['± 3 days', '3'], ['± 7 days', '7']].map(([label, n], i) => (
              <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-flex={n}>{label}</button>
            ))}
          </div>
          </div>
          <div class="dates__panel flexi" data-date-panel="flexible" hidden>
            <p class="flexi__q">How long would you like to stay?</p>
            <div class="flexi__lengths" role="group" aria-label="How long">
              {[['Weekend', 'weekend'], ['Week', 'week'], ['Month', 'month']].map(([label, key]) => (
                <button class="chip" type="button" aria-pressed={key === 'week' ? 'true' : 'false'} data-length={key}>{label}</button>
              ))}
            </div>
            <p class="flexi__q">When do you want to go?</p>
            <div class="flexi__months">
              <button class="cal__arrow flexi__arrow flexi__arrow--prev" type="button" aria-label="Earlier months" data-months-prev><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <div class="flexi__track" role="group" aria-label="Months" data-months></div>
              <button class="cal__arrow flexi__arrow flexi__arrow--next" type="button" aria-label="Later months" data-months-next><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
          </div>
          <div class="dates__foot">
            <span class="dates__nights" data-nights data-morph aria-live="polite">Choose your check-in</span>
            <button class="link" type="button" data-dates-clear>Clear dates</button>
            <button class="btn btn--dark" type="button" data-dates-done>Done</button>
          </div>
        </div>
      </div>

      <div class="field" data-field="who">
        <button class="field__btn" type="button" aria-haspopup="true" aria-expanded="false">
          <span class="field__name">Who</span>
          <span class="field__value" data-value>2 guests</span>
        </button>
        <div class="pop" aria-label="Who">
          <p class="pop__title">Who’s travelling?</p>
          {[['Adults', 'adults', 2, 1], ['Children', 'children', 0, 0], ['Rooms', 'rooms', 1, 1]].map(([label, key, value, min]) => (
            <div class="stepper" data-step={key} data-min={min}>
              <span>{label}</span>
              <span class="stepper__ctrl">
                <button type="button" data-dir="-1" aria-label={`Fewer ${String(label).toLowerCase()}`}>−</button>
                <output>{value}</output>
                <button type="button" data-dir="1" aria-label={`More ${String(label).toLowerCase()}`}>+</button>
              </span>
            </div>
          ))}
        </div>
      </div>

      <div class="field field--tell" data-field="tell">
        <button class="field__btn" type="button" aria-haspopup="dialog" aria-expanded="false">
          <span class="field__name">Or tell your agent</span>
          <span class="field__value tell__value" data-tell-value></span>
          <span class="tell__ghost" data-ghost data-examples={JSON.stringify(hero.tellUsExamples)} aria-hidden="true">“{hero.tellUsExamples[0]}”</span>
        </button>
        <div class="pop pop--tell" role="dialog" aria-labelledby="tell-title">
          <p class="pop__title serif" id="tell-title">Tell your agent</p>
          <div class="pop__chips">
            {suggestions.map((t) => <button class="chip" type="button" aria-pressed="false" data-suggest={t}>{t}</button>)}
          </div>
          <div class="tell__box">
            <textarea name="brief" rows="5" aria-label="Describe the trip you have in mind" data-tell></textarea>
            <span class="tell__example" data-brief-ghost aria-hidden="true">{hero.tellUsExamples[0]}</span>
          </div>
          <div class="tell__foot">
            <button class="link" type="button" data-tell-reset>Reset</button>
            <span class="tell__hint">Replies on WhatsApp · a hotel in minutes, bigger trips within a few hours</span>
            <button class="btn btn--dark" type="button" data-tell-done>Send to agent</button>
          </div>
        </div>
      </div>

      <button class="btn btn--dark search__submit" type="submit" data-submit>
        <span class="search__label" data-submit-label>Search</span>
      </button>
    </form>

    <a class="search__helper link" href="#" data-focus-tell>{hero.helper} →</a>
  </div>
</section>

<div class="toast" role="status" aria-live="polite" data-toast>
  <span class="toast__dot"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  <span><span data-toast-title>Leave it with us.</span><small data-toast-body></small></span>
</div>
