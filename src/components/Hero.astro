---
const { hero, destinations } = Astro.props;
const words = hero.headline.split(' ');
const places = ['Anywhere', 'Somewhere warm', ...destinations.slice(0, 4).map((d: any) => d.title)];
const dates = ['Any dates', 'This weekend', 'Next month', 'February half-term', 'Easter', 'Summer'];
const suggestions: string[] = hero.tellSuggestions ?? [
  'Somewhere warm in February',
  'Adults-only and quiet',
  'A villa for the whole family',
  'Short flight, great food',
  'Surprise us',
];
const sparkle = '<svg class="sparkle" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 4l1.9 5.1L18 11l-5.1 1.9L11 18l-1.9-5.1L4 11l5.1-1.9L11 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"/><path d="M19 2v4M17 4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg>';
---
<section class="hero" id="top" data-theme="dark">
  <div class="hero__media">
    <img src={hero.poster.src} alt={hero.poster.alt} fetchpriority="high" decoding="async" />
    {hero.videoUrl && <video src={hero.videoUrl} muted loop playsinline preload="metadata" data-hero-video aria-hidden="true"></video>}
  </div>

  <div class="hero__copy">
    <h1 class="hero__title serif" aria-label={hero.headline}>
      <span class="mask" aria-hidden="true">
        {words.map((w: string, i: number) => <><span style={`--i:${i}`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
      </span>
    </h1>
    <p class="hero__intro">{hero.intro}</p>
  </div>

  <div class="hero__search">
    <div class="tabs" role="tablist" aria-label="What are you looking for" data-tabs>
      <button class="tabs__tab" role="tab" aria-selected="true" data-tab="stays" type="button">Stays</button>
      <button class="tabs__tab" role="tab" aria-selected="false" data-tab="flights" type="button">Flights</button>
      <div class="tabs__active" aria-hidden="true"><span>Stays</span><span>Flights</span></div>
    </div>

    <form class="search" data-search novalidate>
      <div class="field" data-field="where">
        <button class="field__btn" type="button" aria-haspopup="listbox" aria-expanded="false">
          <span class="field__name" data-where-label>Where</span>
          <span class="field__value" data-value>Anywhere</span>
        </button>
        <div class="pop" role="listbox" aria-label="Where">
          <p class="pop__title">Start with a place, or a feeling</p>
          {places.map((p, i) => <button class="pop__opt" type="button" role="option" aria-selected={i === 0 ? 'true' : 'false'} data-opt={p}>{p}</button>)}
        </div>
      </div>

      <div class="field" data-field="when">
        <button class="field__btn" type="button" aria-haspopup="true" aria-expanded="false">
          <span class="field__name">When</span>
          <span class="field__value" data-value>Any dates</span>
        </button>
        <div class="pop" aria-label="When">
          <p class="pop__title">Roughly when?</p>
          <div class="pop__chips">
            {dates.map((d, i) => <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-opt={d}>{d}</button>)}
          </div>
        </div>
      </div>

      <div class="field" data-field="who">
        <button class="field__btn" type="button" aria-haspopup="true" aria-expanded="false">
          <span class="field__name">Who</span>
          <span class="field__value" data-value>2 guests</span>
        </button>
        <div class="pop" aria-label="Who">
          <p class="pop__title">Who’s travelling?</p>
          {[['Adults', 'adults', 2, 1], ['Children', 'children', 0, 0], ['Rooms', 'rooms', 1, 1]].map(([label, key, value, min]) => (
            <div class="stepper" data-step={key} data-min={min}>
              <span>{label}</span>
              <span class="stepper__ctrl">
                <button type="button" data-dir="-1" aria-label={`Fewer ${String(label).toLowerCase()}`}>−</button>
                <output>{value}</output>
                <button type="button" data-dir="1" aria-label={`More ${String(label).toLowerCase()}`}>+</button>
              </span>
            </div>
          ))}
        </div>
      </div>

      <div class="field field--tell" data-field="tell">
        <button class="field__btn" type="button" aria-haspopup="dialog" aria-expanded="false">
          <span class="field__name"><Fragment set:html={sparkle} />Or just tell us <em class="beta">Beta</em></span>
          <span class="field__value tell__value" data-tell-value></span>
          <span class="tell__ghost" data-ghost data-examples={JSON.stringify(hero.tellUsExamples)} aria-hidden="true">“{hero.tellUsExamples[0]}”</span>
        </button>
        <div class="pop pop--tell" role="dialog" aria-label="Just tell us">
          <div class="tell__head">
            <p class="tell__title serif">Just tell us</p>
            <span class="tell__optional">(optional)</span>
            <em class="beta">Beta</em>
          </div>
          <textarea name="brief" rows="3" placeholder="Describe the trip you have in mind…" aria-label="Describe the trip you have in mind" data-tell></textarea>
          <div class="pop__chips tell__chips">
            {suggestions.map((t) => <button class="chip" type="button" aria-pressed="false" data-suggest={t}>{t}</button>)}
          </div>
          <div class="tell__foot">
            <button class="link" type="button" data-tell-reset>Reset</button>
            <button class="btn btn--dark" type="button" data-tell-done>Done</button>
          </div>
        </div>
      </div>

      <button class="btn btn--dark search__submit" type="submit" data-submit>
        <span>Search</span>
        <span class="is-sent" aria-hidden="true">Sent</span>
      </button>
    </form>

    <a class="search__helper link" href="#" data-focus-tell>{hero.helper} →</a>
  </div>
</section>

<div class="toast" role="status" aria-live="polite" data-toast>
  <span class="toast__dot"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  <span><span data-toast-title>Leave it with us.</span><small data-toast-body></small></span>
</div>
