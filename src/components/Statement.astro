---
const { text, theme = 'green', size } = Astro.props;
const words: string[] = text.split(' ');
---
<section class:list={["statement section", size && `statement--${size}`]} data-inview data-theme={theme} data-theme-early>
  <span class="statement__rule statement__rule--top"></span>
  <p class="serif words" aria-label={text} data-inview data-threshold="0.4">
    {words.map((w, i) => <><span class="w" style={`--i:${i}`} aria-hidden="true">{w}</span>{' '}</>)}
  </p>
  <span class="statement__rule statement__rule--bottom"></span>
</section>
