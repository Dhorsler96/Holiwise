---
import Login from './Login.astro';
const { settings } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// On the Premium page the member button scrolls to the request form; elsewhere it goes there
const onPremium = path === '/premium';
const requestHref = onPremium ? '#request' : '/premium#request';
---
<header class="nav" data-nav>
  <a class="nav__brand" href="/" aria-label="Holiwise home">HOLIWISE</a>
  <nav class="nav__links" aria-label="Main">
    {settings.nav.map((item: any) => <a class="link" href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="nav__actions">
    <a class="link nav__login" href="#login" data-login-open>Log in</a>
    <a class="btn btn--ghost-light" href={requestHref} data-to-request={onPremium ? '' : undefined}>Become a member</a>
  </div>
</header>
<Login requestHref={requestHref} />
