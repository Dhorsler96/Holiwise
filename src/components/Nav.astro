---
const { settings } = Astro.props;
---
<header class="nav" data-nav>
  <a class="nav__brand" href="/" aria-label="Holiwise home">HOLIWISE</a>
  <nav class="nav__links" aria-label="Main">
    {settings.nav.map((item: any) => <a class="link" href={item.href}>{item.label}</a>)}
  </nav>
  <div class="nav__actions">
    <a class="link nav__invite" href="#">{settings.inviteLabel}</a>
    <a class="btn btn--ghost-light" href={settings.agentHref}>{settings.agentLabel}</a>
  </div>
</header>
