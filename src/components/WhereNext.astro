---
const { data } = Astro.props;
---
<section class="where section" id="where-next">
  <div class="where__head" data-reveal data-inview>
    <div>
      <h2 class="where__title serif">{data.heading}</h2>
      <p class="where__intro">{data.intro}</p>
    </div>
    <div class="where__controls">
      <button class="round" type="button" aria-label="Previous idea" data-prev><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button class="round" type="button" aria-label="Next idea" data-next><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <a class="btn btn--ghost-dark" href="#">{data.ctaLabel}</a>
    </div>
  </div>

  <div class="carousel" data-carousel tabindex="0" role="region" aria-roledescription="carousel" aria-label={data.heading}>
    <div class="carousel__track" data-track>
      {data.destinations.map((d: any, i: number) => (
        <article class:list={['card', { 'is-active': i === 0 }]} data-inview aria-label={`${i + 1} of ${data.destinations.length}: ${d.title}`}>
          <div class="card__media" data-wipe style={d.image.lqip ? `background-image:url(${d.image.lqip})` : undefined}>
            <img src={d.image.src} alt={d.image.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
          </div>
          <div class="card__body">
            <h3 class="card__title">{d.title}</h3>
            <p class="card__summary">{d.summary}</p>
            <a class="arrow-link" href="#top" data-ask={d.title}>Ask about this <span>→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
