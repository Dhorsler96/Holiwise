---
const { data } = Astro.props;
---
<section class="where section" id="where-next" data-theme="light">
  <div class="where__head" data-reveal data-inview>
    <div>
      <h2 class="where__title serif">{data.heading}</h2>
      <p class="where__intro">{data.intro}</p>
    </div>
    <div class="where__controls">
      <button class="round" type="button" aria-label="Previous idea" data-prev><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button class="round" type="button" aria-label="Next idea" data-next><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <a class="btn btn--ghost-dark" href="#">{data.ctaLabel}</a>
    </div>
  </div>

  <div class="carousel" data-carousel data-inview data-threshold="0.2" tabindex="0" role="region" aria-roledescription="carousel" aria-label={data.heading}>
    <div class="carousel__track" data-track data-count={data.destinations.length}>
      {/* Three copies so the carousel loops with a card peeking on both sides. Only the middle copy is exposed to assistive tech. */}
      {[0, 1, 2].flatMap((copy) => data.destinations.map((d: any, i: number) => {
        const real = copy === 1;
        return (
          <article class:list={['card', { 'is-active': real && i === 0 }]} aria-hidden={real ? undefined : 'true'} inert={!real} aria-label={real ? `${i + 1} of ${data.destinations.length}: ${d.title}` : undefined}>
            <div class="card__media" data-focus style={d.image.lqip ? `background-image:url(${d.image.lqip})` : undefined}>
              <img src={d.image.src} alt={real ? d.image.alt : ''} loading="eager" decoding="async" draggable="false" />
            </div>
            <div class="card__body">
              <h3 class="card__title">{d.title}</h3>
              <p class="card__summary">{d.summary}</p>
              <a class="arrow-link" href="#top" data-ask={d.title}><span class="arrow-link__text">Ask about this</span> <span class="arrow-link__arrow" aria-hidden="true">→</span></a>
            </div>
          </article>
        );
      }))}
    </div>
  </div>
</section>
